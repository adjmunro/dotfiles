syntax on			" Syntax highlighting
set relativenumber	" Relative line numbers
set number			" Absolute line numbers
set ruler			" Always shows location in a file (line#)
set smarttab		" Autotabs for certain code
set shiftwidth=4	" Columns indented via indent operations
set tabstop=4		" Rendered tab width in vim (no real effect) 
set showmatch		" Shows matching brackets
set noexpandtab		" Forbids converting tab characters into spaces
