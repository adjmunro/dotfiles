# Private keys live in 1Password. Each IdentityFile is a public key, which only
# tells ssh which of the agent's keys to offer, so each host gets the right one.
# Never put a private key in this directory: it is a public repo.

# Hosts generated by 1Password from SSH bookmarks (key items with ssh:// URLs).
Include ~/.ssh/1Password/config

### GitHub ###

# Personal GitHub account.
Host github.com
	User git
	IdentityFile ~/.ssh/github.pub
	IdentitiesOnly yes

# Work GitHub account (see `alphero.gitconfig`).
Host github-alphero
	HostName github.com
	User git
	IdentityFile ~/.ssh/alphero.pub
	IdentitiesOnly yes

### Tailnet (MagicDNS names only!) ###

# Offsite-Mirror
Host abra
	IdentityFile ~/.ssh/abra.pub
	IdentitiesOnly yes

# Desktop
Host magikarp
	IdentityFile ~/.ssh/magikarp.pub
	IdentitiesOnly yes

# Storage
Host snorlax
	IdentityFile ~/.ssh/snorlax.pub
	IdentitiesOnly yes

# 1Password's agent socket. Linux creates it here; on macOS it is a symlink to
# the app's Group Container socket, made by _01_env/50-1password.zsh.
Host *
	IdentityAgent ~/.1password/agent.sock
