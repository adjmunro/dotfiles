{
  "permissions": {
    "allow": [
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(* list:*)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git reflog:*)",
      "Bash(git show:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git cherry:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",

      "Bash(brew info:*)",
      "Bash(brew search:*)",
      "Bash(brew list:*)",
      "Bash(brew deps:*)",
      "Bash(brew uses:*)",
      "Bash(brew outdated:*)",
      "Bash(brew leaves:*)",

      "Bash(stow:*)",

      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(bat:*)",
      "Bash(less:*)",
      "Bash(head:*)",
      "Bash(tail:*)",

      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",

      "Bash(ls:*)",
      "Bash(eza:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(fzf:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(egrep:*)",
      "Bash(fgrep:*)",
      "Bash(pgrep:*)",

      "Bash(ffmpeg:*)",

      "Bash(open:*)",
      "Bash(du:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "Bash(sw_vers:*)",
      "Bash(ps:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",

      "Bash(adb:*)",
      "Bash(./gradlew:*)",

      "Bash(just:*)",
      "Bash(gt create:*)",
      "Bash(gt commit create:*)",
      "Bash(gt ls:*)",
      "Bash(gh pr:*)",
      "Bash(wrkflw validate:*)",

      "Read(~/Developer/**)",

      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.gradle.org)",
      "WebFetch(domain:jetbrains.com)",
      "WebFetch(domain:kotlinlang.org)",
      "WebSearch"
    ],
    "deny": []
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-bash.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "firebase@claude-plugins-official": false
  },
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
