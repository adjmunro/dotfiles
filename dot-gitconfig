# IMPORTANT! Always use github's noreply alias for email addresses to avoid leaking PII!

# Default identity.
[user]
	name = Adam Munro
    # Refuse to commit until a valid identity is set via includeIf.
    # Repos at github.com/adjmunro are routed to ~/.config/git/personal.gitconfig 
    useConfigOnly = true

[gpg]
    # Reuse our SSH Authentication Key as a Signing Key instead of GPG.
	format = ssh

[gpg "ssh"]
    # Derive all SSH keys from 1Password, to keep it out of reach of agents. 
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    # Put your public keys in here so that git can validate it is used correctly.
	allowedSignersFile = ~/.config/git/allowed_signers

[init]
	defaultBranch = develop

[commit]
    # Commit signing needs to be disabled for uninterrupted LLM work.
    # Use a pre-push git hook and repo rules to enforce signing.
	gpgsign = false

[branch]
	autoSetupMerge = false

[push]
    autoSetupRemote = true

[core]
    editor = vim
	# Convert CRLF to LF on commit, never the reverse on checkout, so files
	# edited on Windows can't sneak CRLF into history. (Windows itself wants
	# `true`, which Git for Windows sets system-wide.) A repo's .gitattributes
	# (`* text=auto`) overrides this and is the portable fix for shared repos.
	autocrlf = input

[url "git@github.com:"]
	insteadOf = https://github.com/

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

# Settings for repos at github/adjmunro
[includeIf "hasconfig:remote.*.url:git@github.com:adjmunro/**"]
	path = ~/.config/git/personal.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/adjmunro/**"]
	path = ~/.config/git/personal.gitconfig

# Settings for repos at github/alphero
[includeIf "hasconfig:remote.*.url:git@github.com:adjmunro/**"]
	path = ~/.config/git/personal.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/adjmunro/**"]
	path = ~/.config/git/personal.gitconfig

# ─────────────────────────────────────────────────────────────────────────────
# Conflict resolution & rebasing
# Added 2026-07-21. Tuned for agent/LLM-assisted rebasing and the atomic-commit
# workflow in ~/.claude/CLAUDE.md (fold fixes into offending commits, keep
# topological changes separate, preserve intent across conflicts).
# ─────────────────────────────────────────────────────────────────────────────

[rerere]
	# "Reuse Recorded Resolution" — records how a conflict was resolved and
	# replays it automatically when the identical conflict recurs.
	#
	# DELIBERATELY DISABLED (2026-07-21). Rationale: this config is used across
	# many independent Claude Code sessions. A fresh agent doesn't know rerere is
	# on, so it won't run `git rerere status`, and with autoUpdate the replayed
	# resolution is pre-staged — the "conflict" never surfaces and the agent can
	# `git rebase --continue` over a STALE resolution without ever reviewing it.
	# Detection is the weak link; the only signal is a single stderr line
	# ("Resolved '<path>' using previous resolution").
	#
	# The upside — not re-typing a resolution — is a human-fatigue optimisation
	# an LLM doesn't need; re-resolving from scratch actually re-examines the
	# merge base each time, which is what the /rebase workflow wants anyway.
	#
	# To recover if it ever gets re-enabled and replays a wrong resolution:
	#   git rerere forget <path>
	#   git checkout --conflict=zdiff3 -- <path>   # restore the real markers
	#
	# Middle ground if you want the assist back WITH a review checkpoint: set
	# `enabled = true` but leave autoUpdate off — resolutions are pre-filled but
	# left UNSTAGED, so `git status` still shows the path unmerged and forces a
	# `git add` (a mandatory review point) before continuing.
	enabled = false

[merge]
	# Conflict marker style. zdiff3 (git 2.35+) adds a third section between
	# ||||||| and ======= showing the COMMON ANCESTOR (merge base) of the two
	# sides, and hoists shared context out of the conflict region. Seeing the
	# base is what lets both a human and an LLM reconstruct the intent of each
	# side rather than guessing — the core requirement of the /rebase workflow.
	# Trade-off: markers are longer/noisier by eye (irrelevant to tooling).
	conflictStyle = zdiff3
	# On merge, if one side renamed a directory, add new files created on the
	# other side into the renamed directory instead of leaving them at the old
	# path. Reduces spurious conflicts when file/dir moves (topological commits)
	# meet behavioural changes.
	directoryRenames = true

[rebase]
	# When rebasing, automatically advance any OTHER local branch refs that point
	# at commits being rebased (stacked/dependent branches), instead of stranding
	# them on the pre-rebase commits. Matches the "same-named remote per branch"
	# stacked-branch discipline. (git 2.55 fixed a HEAD-movement bug here.)
	updateRefs = true
	# Treat `fixup!`/`squash!` commits as squash instructions automatically, so
	# `git rebase -i` behaves as if --autosquash were always passed. Pairs with
	# `git commit --fixup=<sha>` for folding fixes into earlier commits.
	# (Note: the new non-interactive `git history fixup <sha>` is often better.)
	autoSquash = true
	# If the working tree is dirty when a rebase starts, stash the changes, run
	# the rebase, then reapply — instead of refusing with "cannot rebase: you
	# have unstaged changes." Saves a manual stash/pop dance.
	autoStash = true
	# Safety rail: if an interactive-rebase todo list drops a commit that was
	# present (e.g. an accidentally deleted line), abort with an error rather
	# than silently discarding the commit. Important guardrail when a todo list
	# is edited programmatically.
	missingCommitsCheck = error

[diff]
	# Histogram diff produces more semantically stable, human-meaningful hunks
	# than the default Myers algorithm — especially around moved/duplicated
	# lines and reordered blocks. More stable hunks => cleaner rebases and fewer
	# false conflicts. Low cost on normal-sized diffs.
	algorithm = histogram
	# Colour lines that were MOVED within a diff differently from genuinely
	# added/removed lines, so a pure code move reads as a move rather than a
	# delete+add. Directly supports the "isolate code moves from behavioural
	# change" review rule. ("default" = zebra, only detects non-trivial moves.)
	colorMoved = default

[fetch]
	# Automatically prune remote-tracking refs (origin/*) that no longer exist
	# on the remote whenever you fetch. Keeps `git branch -r` honest after
	# upstream branches are merged/deleted; avoids acting on stale refs.
	prune = true

[column]
	# Let Git lay out list output (branches, tags, status hints, etc.) in columns
	# when writing to a terminal, and fall back to one-per-line when piped.
	ui = auto
