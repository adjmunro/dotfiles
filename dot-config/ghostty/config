###############################################################
### Ghostty Shared Config! Use .ghostty-local for local-config 
###############################################################
# Font & Text
font-size = 16
cursor-invert-fg-bg = true
selection-invert-fg-bg = true
scroll-to-bottom = keystroke, no-output

# Theme
theme = dark:"00-SoftDark", light:"02-PrimaryAccessible"

# Window
background-blur-radius = 20
background-opacity = 0.8
cursor-click-to-move = true
focus-follows-mouse = true
initial-window = false
macos-titlebar-style = tabs
mouse-hide-while-typing = true
window-inherit-working-directory = true
window-padding-balance = true
window-padding-color = extend
window-padding-x = 20
window-padding-y = 20
window-height = 67
window-width = 102
window-save-state = always

# Split
unfocused-split-opacity = 0.15

# Quick Terminal
quick-terminal-position = center
quick-terminal-size = 80%, 80%


# Keybindings
keybind = global:command+grave_accent=toggle_quick_terminal

# Keep macOS-style line navigation and selection working inside Zsh.
keybind = home=csi:H
keybind = end=csi:F
keybind = opt+delete=csi:3;3~
keybind = command+delete=csi:3;9~
keybind = command+left=csi:1;9D
keybind = command+right=csi:1;9C
keybind = shift+left=csi:1;2D
keybind = shift+right=csi:1;2C
keybind = shift+home=csi:1;2H
keybind = shift+end=csi:1;2F
keybind = shift+up=csi:1;2A
keybind = shift+down=csi:1;2B
keybind = shift+enter=esc:\r
keybind = shift+opt+left=csi:1;4D
keybind = shift+opt+right=csi:1;4C
keybind = shift+command+left=csi:1;10D
keybind = shift+command+right=csi:1;10C

# Other Config Files
config-file = ?./local-config
