#!/usr/bin/env zsh

# Export the location of symlinked dotfiles repository directory.
export DOTFILES="$(dirname "$(realpath ${(%):-%N})")"

# Function to source every file in an array (i.e. globbed path)
function sources() {
    if [[ "$1" == *'*'* ]]; then 
        echo "Globbed nothing. $1"
        echo "You might have accidentally quoted?"
        return false
    fi

    for file in $@; do
        echo "Source $file"
        source $file
    done
    echo ""
}

# Glob & source environmental variables
sources $DOTFILES/_zshenv/*.zsh
sources $DOTFILES/*/env.zsh
sources "$HOME/.zlocal"

export BREW="/opt/homebrew/bin"
