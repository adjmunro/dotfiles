#!/usr/bin/env zsh

# --------------------------------------------------------------------------- #

# If unset, define location of symlinked dotfiles directory as a global [-g],
# read-only [-r], and exported [-x] to child processes property. This cannot be
# changed in the current session unless the shell session is restarted.
(( ${+DOTFILES} )) || typeset -grx DOTFILES="$(dirname "$(realpath ${(%):-%N})")"

# --------------------------------------------------------------------------- #

# Load any machine specific variables
[[ -f "$DOTFILES/_local.zsh" ]] && source "$DOTFILES/_local.zsh"

# Declare logger
source "$DOTFILES/_libs/logger.zsh"

# Declare source-dir
source "$DOTFILES/_libs/looper.zsh"

# Source all zshenv files
source-dir "_01_env"
