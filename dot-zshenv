#!/usr/bin/env zsh

# Get any local config
if [[ -f "$HOME/.zlocal" ]]; then
    source "$HOME/.zlocal"
fi

# Export the location of symlinked dotfiles repository directory.
export DOTFILES="$(dirname "$(realpath ${(%):-%N})")"

# Function to source every file in an array (i.e. globbed path)
function sources() {
    # Keeps options local to the function
    emulate -L zsh

    # Locally enable null globs as acceptable. 
    # Alternatively can do *.zsh(N) at callsite
    setopt null_glob

    local verbose=false
    local -a patterns=()
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "-v" || "$arg" == "--verbose" ]]; then
            verbose=true
        else
            patterns+=("$arg")
        fi
    done

    # Expand ~ and any globs
    setopt extended_glob
    local -a expanded
    expanded=(${~patterns}) # ${~...} forces expansion

    if (( ${#expanded} == 0 )); then 
        if $verbose; then
            echo "Globbed nothing."
        fi
        return 0
    fi

    for file in "${expanded[@]}"; do
        if $verbose; then
            echo "+ $file"
        fi
        source "$file"
    done
    if $verbose; then
        echo ""
    fi
}

# Glob & source environmental variables
sources ${DOTFILES}/_zsh/env.zsh(N)
sources "$DOTFILES/*/env.zsh"
